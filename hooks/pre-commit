#!/bin/bash
#
# Lints the Swift files staged for this commit with the same rules as make lint.

set -eo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

files=()
while IFS= read -r file; do
  files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')

[ ${#files[@]} -eq 0 ] && exit 0

echo "pre-commit: linting ${#files[@]} staged Swift file(s)"
status=0
swiftlint lint --quiet --strict --force-exclude "${files[@]}" || status=1
if ! findings=$(swiftformat --lint "${files[@]}" 2>&1); then
  echo "$findings" | grep -E "error|warning" >&2
  status=1
fi

if [ $status -ne 0 ]; then
  echo "pre-commit: fix the findings above, or run swiftformat on the files, then stage them again" >&2
fi
exit $status
